# ── Serveur MCP ────────────────────────────────────────────────────
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_ENV=local
LOG_LEVEL=INFO

# Mode sans session (auto-activé sur Vercel via VERCEL=1)
# MCP_STATELESS_HTTP=true
# MCP_JSON_RESPONSE=true

# ── Données Québec (CKAN) ──────────────────────────────────────────
DQ_API_URL=https://www.donneesquebec.ca/recherche/api/3/action
DQ_BASE_URL=https://www.donneesquebec.ca/recherche

# ── Ville de Montréal (CKAN) ───────────────────────────────────────
MTL_API_URL=https://donnees.montreal.ca/api/3/action
MTL_BASE_URL=https://donnees.montreal.ca

# ── Murales subventionnées (DataStore Montréal + viewer MTL Murales)
# MURALES_DATASET_ID=murales
# MURALES_RESOURCE_ID=f02401c2-8336-4086-9955-4c5592ace72e
# MURALES_VIEWER_URL=https://www.mtlmurales.ca/fr

# ── Géospatial (IGO / OGC) ─────────────────────────────────────────
GEO_WMS_URL=https://geoegl.msp.gouv.qc.ca/ws/igo_gouvouvert.fcgi
GEO_WFS_URL=https://geoegl.msp.gouv.qc.ca/ws/igo_gouvouvert.fcgi

# ── Geocodage (Adresses Québec / ICherche) ─────────────────────────
GEOCODER_URL=https://geoegl.msp.gouv.qc.ca/apis/icherche

# ── Vitrine linguistique (OQLF) ────────────────────────────────────
VITRINE_BASE_URL=https://vitrinelinguistique.oqlf.gouv.qc.ca

# ── NosOrigines ────────────────────────────────────────────────────
NOSORIGINES_BASE_URL=https://www.nosorigines.qc.ca

# ── La bicyclette (comptages vélo Montréal) ────────────────────────
LABICYCLETTE_BASE_URL=https://www.labicyclette.ca

# ── Collecte MTL (calendrier de collecte Montréal) ─────────────────
COLLECTEMTL_BASE_URL=https://collectemtl.ca

# ── Hydro-Québec Info-pannes (état du service) ─────────────────────
HYDRO_INFOPANNES_API_URL=https://services-bs.solutions.hydroquebec.com/pan/web
HYDRO_INFOPANNES_PORTAL_URL=https://infopannes.solutions.hydroquebec.com

# ── Festivals Montréal (Piknic / Jazz Fest) ────────────────────────
PIKNIC_BASE_URL=https://piknicelectronik.com
JAZZFEST_BASE_URL=https://montrealjazzfest.com

# ── Événements publics (CKAN package + CSV DataStore) ──────────────
# EVENEMENTS_PACKAGE_ID=vmtl-evenements-publics
# EVENEMENTS_CSV_RESOURCE_ID=6decf611-6f11-4f34-bb36-324d804c9bad

# ── Contexte utilisateur (date / GPS agent / IP client) ────────────
# DEFAULT_TIMEZONE=America/Toronto
# IP_GEO_URL_TEMPLATE=https://ipapi.co/{ip}/json/

# ── Avis et alertes (Données Montréal GeoJSON) ───────────────────────
# AVIS_ALERTES_DATASET_ID=avis-alertes
# AVIS_ALERTES_GEOJSON_RESOURCE_ID=d249e452-46f5-422f-91ae-898c98eea6cc
# AVIS_ALERTES_VIEWER_URL=https://montreal.ca/avis-et-alertes

# ── Parcs / BIXI / QUALO (nearby) ───────────────────────────────────
# PARCS_DATASET_ID=grands-parcs-parcs-d-arrondissements-et-espaces-publics
# PARCS_GEOJSON_RESOURCE_ID=35796624-15df-4503-a569-797665f8768e
# BIXI_GBFS_BASE_URL=https://gbfs.velobixi.com/gbfs/en
# QUALO_DATASET_ID=rsma-qualite-de-l-eau-en-rive-qualo
# QUALO_RESOURCE_ID=9136d84a-8273-4777-ad68-9ab05d270322

# Defaults for all portal URLs / dataset IDs live in helpers/common/urls.py
# (SOURCES registry). Env vars above override those defaults at runtime.

# ── HTTP ────────────────────────────────────────────────────────────
# HTTP_TIMEOUT=30.0
# HTTP_MAX_RETRIES=3

# ── Limites (mémoire uniquement — pas d'écriture disque) ───────────
# Local / Docker : 50 Mo. Sur Vercel le défaut passe à 5 Mo.
# DOWNLOAD_MAX_BYTES=52428800
# HTTP_CACHE_TTL_SECONDS=60.0
# HTTP_CACHE_MAX_ENTRIES=256

# ── Observabilité (optionnel) ──────────────────────────────────────
# SENTRY_DSN=https://xxx@sentry.io/yyy
# SENTRY_SAMPLE_RATE=1.0
